<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>it.its.cinema</groupId>
	<artifactId>shows-service</artifactId>
	<version>1.0.0</version>
	<name>shows-service</name>
	<description>Catalogo film e spettacoli, disponibilita' e prenotazione dei posti.</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<springdoc.version>3.1.0</springdoc.version>
		<!-- giorno 6, passo 6.8b — il "release train" di Spring Cloud.
		     Non e' una versione qualsiasi: ogni train e' allineato a una
		     versione di Spring Boot. Il 2025.1.x va con Boot 4.x; con un
		     train piu' vecchio il contesto non parte nemmeno. -->
		<spring-cloud.version>2025.1.3</spring-cloud.version>
	</properties>
	<!-- giorno 6, passo 6.8b — il BOM di Spring Cloud governa le versioni
	     di tutto cio' che sta sotto org.springframework.cloud: per questo
	     la dipendenza di openfeign qui sotto non ha <version>. -->
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring-cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<dependencies>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>
		<!-- OpenAPI + Swagger UI (passo 4.7, anticipato al G1).
            Porta con se' le annotazioni io.swagger.v3.oas.annotations:
            @Operation, @ApiResponses, @Schema, @Tag. -->
		<dependency>
			<groupId>org.springdoc</groupId>
			<artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
			<version>${springdoc.version}</version>
		</dependency>

		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<!-- giorno 4, passo 4.5 — Bean Validation.
		     Hibernate Validator arriva gia' di rimbalzo da altre dipendenze,
		     ma "c'e' per caso" non e' "c'e'": basta che una di quelle cambi
		     e la validazione sparisce senza che niente smetta di compilare.
		     Le annotazioni si usano, quindi la dipendenza si dichiara. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<!-- giorno 5, passo 5.5 — l'healthcheck del compose interroga
		     /actuator/health/readiness, e liveness/readiness distinte
		     (passo 5.4) le espone l'actuator. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!--
		  ======================================================================
		  PASSO 9.5 — LE METRICHE IN FORMATO PROMETHEUS.

		  scope runtime: nessuna classe nostra lo importa, serve solo che stia
		  sul classpath. Da quel momento /actuator/prometheus esiste e Spring
		  Boot ci mette dentro, GRATIS, cose che nessuno ha scritto:

		    http.server.requests             quante richieste, quanto lente,
		                                     con quale codice di stato
		    hikaricp.connections.active      quante connessioni del pool sono
		                                     occupate — il numero che spiega
		                                     i blocchi del passo 6.6
		    jvm.memory.used, jvm.gc.*        memoria e garbage collector
		    resilience4j.circuitbreaker.*    lo stato dei breaker del G7
		                                     (solo dove Resilience4j c'e')

		  "Gratis" e' il punto: la strumentazione manuale si scrive una volta,
		  poi si dimentica di aggiornarla, e le metriche mentono. Questa arriva
		  dagli stessi filtri che gestiscono le richieste, quindi non puo'
		  disallinearsi.
		  ======================================================================
		-->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!--
		  ======================================================================
		  PASSO 9.6 — IL TRACING, E LA PRIMA DELLE DUE TRAPPOLE.

		  In Boot 3 si mettevano DUE dipendenze a mano
		  (micrometer-tracing-bridge-brave e zipkin-reporter-brave) e non
		  bastavano: portavano le classi ma NON l'auto-configurazione. I
		  servizi partivano, il traceId compariva perfino nei log, e Zipkin
		  restava ostinatamente vuoto — senza un errore, senza un warning.

		  Lo starter porta tutto, compresa l'auto-configurazione.
		  ======================================================================
		-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-zipkin</artifactId>
		</dependency>
		<!-- giorno 6, passo 6.8b — OpenFeign: il client HTTP DICHIARATIVO.
		     Si dichiara COSA si chiama (un'interfaccia annotata), non COME.
		     La versione la decide il BOM di Spring Cloud qui sopra. -->
		<dependency>
			<groupId>org.springframework.cloud</groupId>
			<artifactId>spring-cloud-starter-openfeign</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>
		<!-- giorno 2-->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-flyway</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<!-- giorno 3 — test di integrazione con PostgreSQL vero.
		     Le versioni le governa il BOM di spring-boot-starter-parent:
		     qui non si scrive nessun <version>. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-testcontainers</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-junit-jupiter</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>testcontainers-postgresql</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-compiler-plugin</artifactId>
				<executions>
					<execution>
						<id>default-compile</id>
						<phase>compile</phase>
						<goals>
							<goal>compile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
					<execution>
						<id>default-testCompile</id>
						<phase>test-compile</phase>
						<goals>
							<goal>testCompile</goal>
						</goals>
						<configuration>
							<annotationProcessorPaths>
								<path>
									<groupId>org.projectlombok</groupId>
									<artifactId>lombok</artifactId>
								</path>
							</annotationProcessorPaths>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<!-- giorno 3 — le classi *IT le esegue failsafe su "mvn verify",
			     non surefire su "mvn test": cosi' "mvn test" resta veloce
			     e non pretende Docker acceso. -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>

</project>
